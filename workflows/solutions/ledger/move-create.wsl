// POST /ledger/journals/{journalId}/moves — create a draft move in a journal.
// Expects JSON body: {date, reference}
// Provided by acme-ledger package.
//
// Per-state failure handlers: each errorable state routes to its own
// <StateName>Failed terminal state with a LITERAL statusCode (chosen per
// failure type) and $Alias.response.message for the message. Avoids the
// WSL ?? operator which doesn't work for $Alias.field??literal when the
// alias exists but the field is missing (tokenSegmentClass includes ?),
// and avoids $? which is overwritten by worker.SetError to 500 on every
// error path.

module ledger_move_create

import datetime/ops
import persistence/store
import sequence/sequence
import services/common

workflow ledger_move_create {
  start: ValidateDate

  state ValidateDate {
    action datetime/ops/ops.Parse(date: $json.date, layout: "2006-01-02") as ValidateResult
    on success -> CheckJournal
    on error -> ValidateDateFailed
  }

  state CheckJournal {
    action persistence/store/store.Get(
      collection: "journals",
      id: $url.journalId
    ) as JournalResult
    on success -> NextId
    on error -> CheckJournalFailed
  }

  state NextId {
    action sequence/sequence.NextByCode(code: "move", scope: "") as IdResult
    on success -> Create
    on error -> NextIdFailed
  }

  state Create {
    action persistence/store/store.Create(
      collection: "moves",
      id: $IdResult.response.formatted,
      doc: {
        id: $IdResult.response.formatted,
        journalId: $url.journalId,
        date: $json.date,
        reference: $json.reference??"",
        state: "draft",
        createdAt: "now",
        updatedAt: "now"
      }
    ) as CreateResult
    on success -> OK
    on error -> CreateFailed
  }

  state OK {
    action services/common/response.Response(
      value: {
        id: $IdResult.response.formatted,
        journalId: $url.journalId,
        date: $json.date,
        reference: $json.reference??"",
        state: "draft",
        lineCount: 0,
        createdAt: "now",
        updatedAt: "now"
      },
      statusCode: 201
    ) as FinalResult
    end ok
  }

  state ValidateDateFailed {
    action services/common/response.Response(
      value: { message: $ValidateResult.response.message, code: $ValidateResult.response.code },
      statusCode: 400
    ) as ErrorResult
    end fail
  }

  state CheckJournalFailed {
    action services/common/response.Response(
      value: { message: $JournalResult.response.message, code: $JournalResult.response.code },
      statusCode: 404
    ) as ErrorResult
    end fail
  }

  state NextIdFailed {
    action services/common/response.Response(
      value: { message: $IdResult.response.message, code: "move_create_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state CreateFailed {
    action services/common/response.Response(
      value: { message: $CreateResult.response.message, code: $CreateResult.response.code },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
