// POST /ledger/moves/{moveId}/lines — add a debit/credit line to a draft move.
// Expects JSON body: {accountCode, debit, credit, description}
// Provided by acme-ledger package.
//
// Per-state failure handlers: each errorable state routes to its own
// <StateName>Failed terminal state with a LITERAL statusCode (chosen per
// failure type) and $Alias.response.message for the message. Avoids the
// WSL ?? operator which doesn't work for $Alias.field??literal when the
// alias exists but the field is missing (tokenSegmentClass includes ?),
// and avoids $? which is overwritten by worker.SetError to 500 on every
// error path.

module ledger_move_line_add

import ledger/ledger
import persistence/store
import sequence/sequence
import services/common

workflow ledger_move_line_add {
  start: LoadMove

  state LoadMove {
    action persistence/store/store.Get(
      collection: "moves",
      id: $url.moveId
    ) as MoveResult
    on success -> NextLineId
    on error -> LoadMoveFailed
  }

  state NextLineId {
    action sequence/sequence.NextByCode(code: "move-line", scope: "") as IdResult
    on success -> Create
    on error -> NextLineIdFailed
  }

  state Create {
    action persistence/store/store.Create(
      collection: "move_lines",
      id: $IdResult.response.formatted,
      doc: {
        id: $IdResult.response.formatted,
        moveId: $url.moveId,
        accountCode: $json.accountCode,
        debit: $json.debit,
        credit: $json.credit,
        description: $json.description??""
      }
    ) as CreateResult
    on success -> OK
    on error -> CreateFailed
  }

  state OK {
    action services/common/response.Response(
      value: {
        id: $IdResult.response.formatted,
        moveId: $url.moveId,
        accountCode: $json.accountCode,
        debit: $json.debit,
        credit: $json.credit,
        description: $json.description??""
      },
      statusCode: 201
    ) as FinalResult
    end ok
  }

  state LoadMoveFailed {
    action services/common/response.Response(
      value: { message: $MoveResult.response.message, code: $MoveResult.response.code },
      statusCode: 404
    ) as ErrorResult
    end fail
  }

  state NextLineIdFailed {
    action services/common/response.Response(
      value: { message: $IdResult.response.message, code: "line_add_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state CreateFailed {
    action services/common/response.Response(
      value: { message: $CreateResult.response.message, code: $CreateResult.response.code },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
