            },
            {
                method: "DELETE",
                "workflow": "@solutions/invoice/invoice-delete",
                description: "Delete a draft invoice (fails if not draft)",
                require: { url: ["invoiceId"] }
            },
        ],
        "/invoices/{invoiceId}/lines": [
            {
                method: "POST",
                "workflow": "@solutions/invoice/invoice-line-add",
                description: "Add a product line to a draft invoice (tax computed via acme-tax)",
                require: { url: ["invoiceId"], json: ["productId", "qty", "unitPrice", "uomId"] }
            },
        ],
        "/invoices/{invoiceId}/lines/{lineId}": [
            {
                method: "DELETE",
                "workflow": "@solutions/invoice/invoice-line-delete",
                description: "Remove a line from a draft invoice",
                require: { url: ["invoiceId", "lineId"] }
            },
        ],
        "/invoices/{invoiceId}/confirm": [
            {
                method: "POST",
                "workflow": "@solutions/invoice/invoice-confirm",
