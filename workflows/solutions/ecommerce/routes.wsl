            },
        ],
        "/ledger/moves/{moveId}/period": [
            {
                method: "PUT",
                "workflow": "@solutions/ledger/move-set-period",
                description: "Attach a fiscal period to a draft move (PostMove will reject if period is closed)",
                require: {
                    url: ["moveId"],
                    json: ["periodId"]
                }
            },
        ],
        "/ledger/moves/{moveId}/lines": [
            {
                method: "GET",
                "workflow": "@solutions/ledger/move-line-list",
                description: "List all lines on a move",
                require: { url: ["moveId"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/ledger/move-line-add",
                description: "Add a debit/credit line to a draft move",
