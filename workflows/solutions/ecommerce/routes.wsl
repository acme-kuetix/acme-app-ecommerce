            },
        ],
        "/stock/moves": [
            {
                method: "GET",
                "workflow": "@solutions/stock/move-list",
                description: "List moves (optional ?state=draft|confirmed|done|cancelled, ?sourceId=)",
                require: { qs: ["state", "sourceId"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/stock/move-create",
                description: "Create a draft stock move (header only; add lines separately)",
                require: { json: ["reference", "sourceId", "destinationId"] }
            },
        ],
        "/stock/moves/{moveId}": [
            {
                method: "GET",
                "workflow": "@solutions/stock/move-get",
                description: "Get a single move with its lines",
                require: { url: ["moveId"] }
            },
        ],
        "/stock/moves/{moveId}/lines": [
            {
                method: "POST",
                "workflow": "@solutions/stock/move-line-add",
                description: "Add a product line to a draft or confirmed move",
                require: { url: ["moveId"], json: ["productId", "qty", "uomId"] }
            },
        ],
        "/stock/moves/{moveId}/lines/{lineId}": [
            {
                method: "DELETE",
                "workflow": "@solutions/stock/move-line-delete",
                description: "Remove a line from a draft or confirmed move",
                require: { url: ["moveId", "lineId"] }
            },
        ],
        "/stock/moves/{moveId}/confirm": [
            {
                method: "POST",
                "workflow": "@solutions/stock/move-confirm",
                description: "Transition a draft move to confirmed (requires at least one line)",
                require: { url: ["moveId"] }
            },
        ],
        "/stock/moves/{moveId}/done": [
            {
                method: "POST",
                "workflow": "@solutions/stock/move-done",
                description: "Transition a confirmed move to done (immutable thereafter)",
                require: { url: ["moveId"] }
            },
        ],
        "/stock/moves/{moveId}/cancel": [
            {
                method: "POST",
                "workflow": "@solutions/stock/move-cancel",
                description: "Transition a draft or confirmed move to cancelled (done moves cannot be cancelled)",
                require: { url: ["moveId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Tax — Templates and computation (acme-tax)
        // ──────────────────────────────────────────────────────────
        "/tax/templates": [
            {
                method: "GET",
                "workflow": "@solutions/tax/template-list",
                description: "List all tax templates (optional ?active=true)",
                require: { qs: ["active"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/tax/template-create",
                description: "Create a tax template",
                require: { json: ["code", "name", "rate"] }
            },
        ],
        "/tax/templates/{templateId}": [
            {
                method: "GET",
                "workflow": "@solutions/tax/template-get",
                description: "Get a single tax template",
                require: { url: ["templateId"] }
            },
            {
                method: "PUT",
                "workflow": "@solutions/tax/template-update",
                description: "Update a tax template (code is immutable)",
                require: { url: ["templateId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/tax/template-delete",
                description: "Delete a tax template (fails if active — retire first)",
                require: { url: ["templateId"] }
            },
        ],
        "/tax/compute": [
            {
                method: "POST",
                "workflow": "@solutions/tax/compute",
                description: "Compute tax for a base amount using a template (handles includedInPrice both ways)",
                require: { json: ["templateId", "base"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Invoices (acme-invoice) — tax computation wired to acme-tax
        // ──────────────────────────────────────────────────────────
        "/invoices": [
            {
                method: "GET",
                "workflow": "@solutions/invoice/invoice-list",
                description: "List invoices (optional ?state=draft|confirmed|posted|cancelled, ?partnerId=)",
