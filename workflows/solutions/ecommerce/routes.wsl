            },
        ],
        "/invoices/{invoiceId}": [
            {
                method: "GET",
                "workflow": "@solutions/invoice/invoice-get",
                description: "Get a single invoice with lines and computed totals",
                require: { url: ["invoiceId"] }
            },
            {
                method: "PUT",
                "workflow": "@solutions/invoice/invoice-update",
                description: "Update a draft invoice's mutable fields (date, dueDate, reference, note)",
