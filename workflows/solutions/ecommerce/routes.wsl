                method: "POST",
                "workflow": "@solutions/sales/order-send",
                description: "Transition a draft order to sent (requires at least one line)",
                require: { url: ["orderId"] }
            },
        ],
        "/sales-orders/{orderId}/confirm": [
            {
                method: "POST",
                "workflow": "@solutions/sales/order-confirm",
                description: "Transition a sent order to confirmed",
                require: { url: ["orderId"] }
            },
        ],
        "/sales-orders/{orderId}/done": [
            {
                method: "POST",
                "workflow": "@solutions/sales/order-done",
                description: "Transition a confirmed order to done (immutable thereafter)",
                require: { url: ["orderId"] }
            },
        ],
        "/sales-orders/{orderId}/cancel": [
            {
                method: "POST",
                "workflow": "@solutions/sales/order-cancel",
                description: "Transition a draft, sent, or confirmed order to cancelled (done cannot be cancelled)",
                require: { url: ["orderId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Carts (acme-cart) — shopping cart CRUD + checkout
        // ──────────────────────────────────────────────────────────
        "/carts": [
            {
                method: "GET",
                "workflow": "@solutions/cart/cart-list",
                description: "List all carts (optional ?state=draft|converted|abandoned)",
                require: { qs: ["state"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/cart/cart-create",
                description: "Create a draft cart (body: {partnerId, currencyCode})",
                require: { json: ["partnerId", "currencyCode"] }
            },
        ],
        "/carts/{cartId}": [
            {
                method: "GET",
                "workflow": "@solutions/cart/cart-get",
                description: "Get a single cart with its lines",
                require: { url: ["cartId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/cart/cart-delete",
                description: "Delete a cart",
                require: { url: ["cartId"] }
            },
        ],
        "/carts/{cartId}/items": [
            {
                method: "POST",
                "workflow": "@solutions/cart/cart-add-item",
                description: "Add an item to the cart (merges if productId already in cart; body: {productId, qty, unitPrice, uomId, taxTemplateIds?})",
                require: { url: ["cartId"], json: ["productId", "qty", "unitPrice", "uomId"] }
            },
        ],
        "/carts/{cartId}/items/{productId}": [
            {
                method: "PUT",
                "workflow": "@solutions/cart/cart-update-qty",
                description: "Update item quantity (removes line if qty=0; body: {qty})",
                require: { url: ["cartId", "productId"], json: ["qty"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/cart/cart-remove-item",
                description: "Remove an item from the cart",
                require: { url: ["cartId", "productId"] }
            },
        ],
        "/carts/{cartId}/checkout": [
            {
                method: "POST",
                "workflow": "@solutions/ecommerce/checkout",
                description: "Convert cart to completed order: creates sales order + invoice + payment + stock move, marks cart converted",
                require: { url: ["cartId"], json: ["paymentMethodId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Auth — users, groups, permissions, login (acme-auth + std-auth)
        // ──────────────────────────────────────────────────────────
        "/auth/login": [
            {
                method: "POST",
                "workflow": "@solutions/auth/auth-login",
                description: "Authenticate and return a JWT",
                require: { json: ["username", "password"] }
            },
        ],
        "/auth/me": [
            {
                method: "GET",
                "workflow": "@solutions/auth/auth-me",
                description: "Get the current user's profile (Bearer token)",
                require: { headers: ["Authorization"] }
            },
        ],
        "/auth/check-permission": [
            {
                method: "POST",
                "workflow": "@solutions/auth/auth-check-permission",
                description: "Check whether a user has a permission code (granted via groups)",
                require: { json: ["userId", "code"] }
            },
        ],
        "/auth/users": [
            {
                method: "GET",
                "workflow": "@solutions/auth/user-list",
                description: "List users (optional ?activeOnly=true)",
                require: {}
            },
            {
                method: "POST",
                "workflow": "@solutions/auth/user-create",
                description: "Create a new user (password is bcrypt-hashed)",
                require: { json: ["username", "email", "password"] }
            },
        ],
        "/auth/users/{userId}": [
            {
                method: "GET",
                "workflow": "@solutions/auth/user-get",
                description: "Get a single user by id",
                require: { url: ["userId"] }
            },
            {
                method: "PUT",
                "workflow": "@solutions/auth/user-update",
                description: "Update a user's email and active flag (username is immutable)",
                require: { url: ["userId"], json: ["email"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/auth/user-delete",
                description: "Delete a user",
                require: { url: ["userId"] }
            },
        ],
        "/auth/users/{userId}/groups/{groupId}": [
            {
                method: "POST",
                "workflow": "@solutions/auth/user-add-to-group",
                description: "Add a user to a group (idempotent)",
                require: { url: ["userId", "groupId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/auth/user-remove-from-group",
                description: "Remove a user from a group (idempotent)",
                require: { url: ["userId", "groupId"] }
            },
        ],
        "/auth/users/{userId}/password": [
            {
                method: "POST",
                "workflow": "@solutions/auth/user-set-password",
                description: "Admin password reset (bcrypt-hashes the new password)",
                require: { url: ["userId"], json: ["newPassword"] }
            },
        ],
        "/auth/groups": [
            {
                method: "GET",
                "workflow": "@solutions/auth/group-list",
                description: "List groups (optional ?activeOnly=true)",
                require: {}
            },
            {
                method: "POST",
                "workflow": "@solutions/auth/group-create",
                description: "Create a new group (code is unique)",
                require: { json: ["code", "name"] }
            },
        ],
        "/auth/groups/{groupId}": [
            {
                method: "GET",
                "workflow": "@solutions/auth/group-get",
                description: "Get a single group by id",
                require: { url: ["groupId"] }
            },
            {
                method: "PUT",
                "workflow": "@solutions/auth/group-update",
                description: "Update a group's name and active flag (code is immutable)",
                require: { url: ["groupId"], json: ["name"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/auth/group-delete",
                description: "Delete a group (also removes from users and clears permission grants)",
                require: { url: ["groupId"] }
            },
        ],
        "/auth/groups/{groupId}/permissions": [
            {
                method: "GET",
                "workflow": "@solutions/auth/permission-list-by-group",
                description: "List permissions granted to a group",
                require: { url: ["groupId"] }
            },
        ],
        "/auth/groups/{groupId}/permissions/{permissionId}": [
            {
                method: "POST",
                "workflow": "@solutions/auth/permission-grant",
                description: "Grant a permission to a group (idempotent)",
                require: { url: ["groupId", "permissionId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/auth/permission-revoke",
                description: "Revoke a permission from a group (idempotent)",
                require: { url: ["groupId", "permissionId"] }
            },
        ],
        "/auth/permissions": [
            {
                method: "GET",
                "workflow": "@solutions/auth/permission-list",
                description: "List all permissions",
                require: {}
            },
            {
                method: "POST",
                "workflow": "@solutions/auth/permission-create",
                description: "Create a new permission (code is unique)",
                require: { json: ["code", "name", "resource", "action"] }
            },
        ],
        "/auth/permissions/{permissionId}": [
            {
                method: "GET",
                "workflow": "@solutions/auth/permission-get",
                description: "Get a single permission by id",
                require: { url: ["permissionId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/auth/permission-delete",
                description: "Delete a permission (also removes from all groups)",
                require: { url: ["permissionId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Companies (acme-company)
        // ──────────────────────────────────────────────────────────
        "/companies": [
            {
                method: "GET",
                "workflow": "@solutions/company/list",
                description: "List all companies (optional ?active=true|false)",
                require: {}
            },
            {
                method: "POST",
                "workflow": "@solutions/company/create",
                description: "Create a new company",
                require: { json: ["legalName", "baseCurrency", "country"] }
            },
        ],
        "/companies/{id}": [
            {
                method: "GET",
                "workflow": "@solutions/company/get",
                description: "Get a single company by id",
                require: { url: ["id"] }
            },
            {
                method: "PUT",
                "workflow": "@solutions/company/update",
                description: "Update a company",
                require: { url: ["id"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/company/delete",
                description: "Delete a company",
                require: { url: ["id"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Audit (acme-audit)
        // ──────────────────────────────────────────────────────────
        "/audit/entries": [
            {
                method: "GET",
                "workflow": "@solutions/audit/list",
                description: "List audit entries (filters: ?entityType=&entityId=&actor=&workflow=&limit=)",
                require: {}
            },
            {
                method: "POST",
                "workflow": "@solutions/audit/record",
                description: "Record an audit entry (append-only)",
                require: { json: ["workflow"] }
            },
        ],
        "/audit/entries/{entryId}": [
            {
                method: "GET",
                "workflow": "@solutions/audit/get",
                description: "Get a single audit entry by id",
                require: { url: ["entryId"] }
            },
        ],

        // Payments (acme-payment + acme-payment-manual provider)
        // ──────────────────────────────────────────────────────────
        "/payments": [
            {
                method: "GET",
                "workflow": "@solutions/payment/payment-list",
                description: "List payments (?state=, ?partnerId=)",
                require: { qs: ["state", "partnerId"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/payment/payment-create",
                description: "Create a draft payment (body: {partnerId, amount, currencyCode, date, methodId, providerId, reference?, note?})",
                require: { json: ["partnerId", "amount", "currencyCode", "date", "methodId", "providerId"] }
            },
        ],
        "/payments/{paymentId}": [
            {
                method: "GET",
                "workflow": "@solutions/payment/payment-get",
                description: "Get a single payment with allocations",
                require: { url: ["paymentId"] }
            },
            {
                method: "PUT",
                "workflow": "@solutions/payment/payment-update",
                description: "Update a draft payment (body: {date?, reference?, note?})",
                require: { url: ["paymentId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/payment/payment-delete",
                description: "Delete a draft payment (fails if not draft)",
                require: { url: ["paymentId"] }
            },
        ],
        "/payments/{paymentId}/authorize": [
            {
                method: "POST",
                "workflow": "@solutions/payment/payment-authorize",
                description: "Authorize a draft payment (calls provider.Authorize)",
                require: { url: ["paymentId"] }
            },
        ],
        "/payments/{paymentId}/capture": [
            {
                method: "POST",
                "workflow": "@solutions/payment/payment-capture",
                description: "Capture an authorized payment (calls provider.Capture, posts to ledger)",
                require: { url: ["paymentId"] }
            },
        ],
        "/payments/{paymentId}/refund": [
            {
                method: "POST",
                "workflow": "@solutions/payment/payment-refund",
                description: "Refund a captured payment (body: {amount}, full or partial)",
                require: { url: ["paymentId"], json: ["amount"] }
            },
        ],
        "/payments/{paymentId}/void": [
            {
                method: "POST",
                "workflow": "@solutions/payment/payment-void",
                description: "Void a draft or authorized payment",
                require: { url: ["paymentId"] }
            },
        ],
        "/payments/{paymentId}/allocations": [
            {
                method: "GET",
                "workflow": "@solutions/payment/payment-allocation-list",
                description: "List allocations for a payment",
                require: { url: ["paymentId"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/payment/payment-allocation-add",
                description: "Allocate payment to an invoice (body: {invoiceId, amount})",
                require: { url: ["paymentId"], json: ["invoiceId", "amount"] }
            },
        ],
        "/payment-methods": [
            {
                method: "GET",
                "workflow": "@solutions/payment/payment-method-list",
                description: "List payment methods for a partner (?partnerId=)",
                require: { qs: ["partnerId"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/payment/payment-method-create",
                description: "Register a payment method (body: {partnerId, methodType, providerId, providerToken, displayName?, last4?, expiry?})",
                require: { json: ["partnerId", "methodType", "providerId", "providerToken"] }
            },
        ],
    }
}
