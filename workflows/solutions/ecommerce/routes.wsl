            },
        ],
        "/ledger/lines/{moveLineId}": [
            {
                method: "DELETE",
                "workflow": "@solutions/ledger/move-line-delete",
                description: "Delete a line from a draft move",
                require: { url: ["moveLineId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Stock — Locations and Moves (acme-stock)
        // ──────────────────────────────────────────────────────────
        "/stock/locations": [
            {
                method: "GET",
                "workflow": "@solutions/stock/location-list",
                description: "List all locations (optional ?type=warehouse|internal|supplier|customer|production|transit)",
                require: { qs: ["type"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/stock/location-create",
                description: "Create a stock location",
