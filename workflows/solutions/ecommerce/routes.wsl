            },
            {
                method: "PUT",
                "workflow": "@solutions/account/update",
                description: "Update an account",
                require: { url: ["accountId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/account/delete",
                description: "Delete an account (fails if it has children)",
                require: { url: ["accountId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Fiscal years and periods (acme-fiscal)
        // ──────────────────────────────────────────────────────────
        "/fiscal/years": [
            {
                method: "GET",
                "workflow": "@solutions/fiscal/year-list",
                description: "List all fiscal years",
                require: {}
            },
            {
                method: "POST",
                "workflow": "@solutions/fiscal/year-create",
                description: "Create a fiscal year (starts in draft state)",
                require: { json: ["name", "startDate", "endDate"] }
            },
        ],
        "/fiscal/years/{yearId}": [
            {
                method: "GET",
                "workflow": "@solutions/fiscal/year-get",
                description: "Get a single fiscal year",
                require: { url: ["yearId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/fiscal/year-delete",
                description: "Delete a fiscal year and all its periods (must be draft or closed)",
                require: { url: ["yearId"] }
            },
        ],
        "/fiscal/years/{yearId}/open": [
            {
                method: "POST",
                "workflow": "@solutions/fiscal/year-open",
                description: "Transition a fiscal year from draft → open",
                require: { url: ["yearId"] }
            },
        ],
        "/fiscal/years/{yearId}/close": [
            {
                method: "POST",
                "workflow": "@solutions/fiscal/year-close",
                description: "Transition a fiscal year from open → closed (fails if periods are open)",
                require: { url: ["yearId"] }
            },
        ],
        "/fiscal/years/{yearId}/periods": [
            {
                method: "GET",
                "workflow": "@solutions/fiscal/period-list",
                description: "List all periods in a fiscal year",
                require: { url: ["yearId"] }
            },
            {
                method: "POST",
                "workflow": "@solutions/fiscal/period-create",
                description: "Add a period to a fiscal year (starts in draft)",
                require: { url: ["yearId"], json: ["name", "startDate", "endDate"] }
            },
        ],
        "/fiscal/periods/for-date": [
            {
                method: "GET",
                "workflow": "@solutions/fiscal/period-for-date",
                description: "Find the period containing a date (YYYY-MM-DD)",
                require: { qs: ["date"] }
            },
        ],
        "/fiscal/periods/{periodId}": [
            {
                method: "GET",
                "workflow": "@solutions/fiscal/period-get",
                description: "Get a single period",
                require: { url: ["periodId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/fiscal/period-delete",
                description: "Delete a period (must be draft or closed)",
                require: { url: ["periodId"] }
            },
        ],
        "/fiscal/periods/{periodId}/open": [
            {
                method: "POST",
                "workflow": "@solutions/fiscal/period-open",
                description: "Transition a period from draft → open (parent year must be open)",
                require: { url: ["periodId"] }
            },
        ],
        "/fiscal/periods/{periodId}/close": [
            {
                method: "POST",
                "workflow": "@solutions/fiscal/period-close",
                description: "Transition a period from open → closed",
                require: { url: ["periodId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
