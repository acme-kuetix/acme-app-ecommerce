            },
        ],
        "/ledger/moves/{moveId}": [
            {
                method: "GET",
                "workflow": "@solutions/ledger/move-get",
                description: "Get a single move with its lines",
                require: { url: ["moveId"] }
            },
            {
                method: "PUT",
                "workflow": "@solutions/ledger/move-update",
                description: "Update a draft move's date or reference",
                require: { url: ["moveId"] }
            },
            {
                method: "DELETE",
                "workflow": "@solutions/ledger/move-delete",
                description: "Delete a draft move and its lines",
                require: { url: ["moveId"] }
            },
        ],
        "/ledger/moves/{moveId}/post": [
            {
                method: "POST",
                "workflow": "@solutions/ledger/move-post",
                description: "Validate and post a draft move (double-entry balance check; rejects if fiscal period is closed)",
