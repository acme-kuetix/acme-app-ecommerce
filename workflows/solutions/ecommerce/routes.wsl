                require: { url: ["invoiceId"] }
            },
        ],
        "/invoices/{invoiceId}/post": [
            {
                method: "POST",
                "workflow": "@solutions/invoice/invoice-post",
                description: "Transition a confirmed invoice to posted (immutable thereafter; posts ledger move)",
                require: { url: ["invoiceId"] }
            },
        ],
        "/invoices/{invoiceId}/cancel": [
            {
                method: "POST",
                "workflow": "@solutions/invoice/invoice-cancel",
                description: "Transition a draft or confirmed invoice to cancelled (posted cannot be cancelled)",
                require: { url: ["invoiceId"] }
            },
        ],

        // ──────────────────────────────────────────────────────────
        // Sales orders (acme-sales) — tax computation wired to acme-tax
        // ──────────────────────────────────────────────────────────
        "/sales-orders": [
